# Скопируй в .env и заполни данными из Supabase (Project Settings -> API)
# Для мобильных приложений используется anon/public ключ
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Ключ 2GIS MapGL (https://dev.2gis.com) — нужен для вкладки «Карта»
EXPO_PUBLIC_2GIS_MAPGL_KEY=
